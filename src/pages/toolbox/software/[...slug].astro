---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Icon } from '@astrojs/starlight/components';
import { getCollection, render } from 'astro:content';
import Tag from '../../../components/catalog/Tag.astro';
import ItemCard from '../../../components/catalog/ItemCard.astro';
import { getEntrySlugs, getUsedBy } from '../../../lib/software';

export async function getStaticPaths() {
  const software = await getCollection('software', ({ data }) => data.render);

  return software.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const allSoftware = await getCollection('software');
const slugs = getEntrySlugs(allSoftware);
const usedBy = getUsedBy(entry.id, allSoftware);
---

<StarlightPage frontmatter={{ title: entry.data.name }}>
  <div class="software-detail">
    {entry.data.description && (
      <p class="software-detail__description">{entry.data.description}</p>
    )}

    {entry.data.externalLink && (
      <p>
        <a href={entry.data.externalLink} target="_blank" rel="noopener noreferrer">
          Visit website <Icon name="external" size="1rem" />
        </a>
      </p>
    )}

    {entry.data.tags && entry.data.tags.length > 0 && (
      <div class="software-detail__tags">
        <strong>Tags:</strong>
        <span class="software-detail__tag-list">
          {entry.data.tags.map(tag => (
            <Tag tag={tag} isLinked={slugs.has(tag)} />
          ))}
        </span>
      </div>
    )}

    <div class="software-detail__content">
      <Content />
    </div>

    {usedBy.length > 0 && (
      <section class="software-detail__used-by">
        <h2>Used by</h2>
        <p>The following software references {entry.data.name}:</p>
        <div class="software-detail__used-by-grid">
          {usedBy.map(item => (
            <ItemCard
              name={item.data.name}
              slug={item.id}
              description={item.data.description}
              externalLink={item.data.externalLink}
              tags={item.data.tags}
              render={item.data.render}
              slugs={slugs}
            />
          ))}
        </div>
      </section>
    )}
  </div>
</StarlightPage>

<style>
  .software-detail__description {
    font-size: 1.125rem;
    color: var(--sl-color-gray-2);
    margin-bottom: 1rem;
  }

  .software-detail__tags {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 1rem 0;
    flex-wrap: wrap;
  }

  .software-detail__tag-list {
    display: flex;
    gap: 0.375rem;
    flex-wrap: wrap;
  }

  .software-detail__content {
    margin: 2rem 0;
  }

  .software-detail__used-by {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--sl-color-gray-5);
  }

  .software-detail__used-by h2 {
    margin-top: 0;
  }

  .software-detail__used-by-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
    margin-top: 1rem;
  }
</style>

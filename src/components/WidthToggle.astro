---

<button
  class="width-toggle"
  data-width-toggle
  aria-label="Toggle page width"
  title="Toggle between contained and full width"
>
  <svg class="width-toggle__icon width-toggle__icon--contained" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
    <path d="M4 4h16v2H4V4zm2 6h12v2H6v-2zm-2 6h16v2H4v-2z"/>
  </svg>
  <svg class="width-toggle__icon width-toggle__icon--full" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
    <path d="M2 4h20v2H2V4zm0 6h20v2H2v-2zm0 6h20v2H2v-2z"/>
  </svg>
</button>

<script>
  const STORAGE_KEY = 'cretdocs-width-preference';
  const FULL_WIDTH_CLASS = 'layout-full-width';

  function initWidthToggle() {
    const button = document.querySelector('[data-width-toggle]');
    if (!button) return;

    // Load saved preference
    const savedPref = localStorage.getItem(STORAGE_KEY);
    if (savedPref === 'full') {
      document.documentElement.classList.add(FULL_WIDTH_CLASS);
    }
    updateButtonState(button);

    // Handle click
    button.addEventListener('click', () => {
      const isFullWidth = document.documentElement.classList.toggle(FULL_WIDTH_CLASS);
      localStorage.setItem(STORAGE_KEY, isFullWidth ? 'full' : 'contained');
      updateButtonState(button);
    });
  }

  function updateButtonState(button: Element) {
    const isFullWidth = document.documentElement.classList.contains(FULL_WIDTH_CLASS);
    button.setAttribute('data-state', isFullWidth ? 'full' : 'contained');
    button.setAttribute('aria-pressed', String(isFullWidth));
  }

  // Initialize on load and on navigation (for Astro view transitions)
  document.addEventListener('DOMContentLoaded', initWidthToggle);
  document.addEventListener('astro:page-load', initWidthToggle);
</script>

<style is:global>
  /* Width toggle CSS overrides */
  .layout-full-width {
    --sl-content-width: 100%;
  }

  .layout-full-width .content-panel {
    max-width: none;
  }
</style>

<style>
  .width-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    background: transparent;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.375rem;
    color: var(--sl-color-gray-2);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .width-toggle:hover {
    background: var(--sl-color-gray-6);
    border-color: var(--sl-color-gray-4);
    color: var(--sl-color-text);
  }

  .width-toggle__icon {
    display: none;
  }

  .width-toggle[data-state="contained"] .width-toggle__icon--contained,
  .width-toggle:not([data-state]) .width-toggle__icon--contained {
    display: block;
  }

  .width-toggle[data-state="full"] .width-toggle__icon--full {
    display: block;
  }
</style>

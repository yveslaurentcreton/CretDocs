---
import type { SoftwareEntry } from '../../lib/software';
import { getAllTags, getEntrySlugs, categorizeTags, getTagCounts, sortByName } from '../../lib/software';
import FilterSidebar from './FilterSidebar.astro';
import ItemGrid from './ItemGrid.astro';

interface Props {
  items: SoftwareEntry[];
  itemsPerPage?: number;
}

const { items, itemsPerPage = 24 } = Astro.props;

const slugs = getEntrySlugs(items);
const allTags = getAllTags(items);
const { linked, plain } = categorizeTags(allTags, slugs);
const tagCounts = getTagCounts(items);
const sortedItems = sortByName(items);
---

<div class="catalog" data-catalog data-items-per-page={itemsPerPage}>
  <FilterSidebar linkedTags={linked} plainTags={plain} tagCounts={tagCounts} />

  <main class="catalog__content">
    <div class="catalog__header">
      <span class="catalog__count" data-filter-count>
        Showing {sortedItems.length} items
      </span>
      <button class="catalog__clear" data-clear-filters hidden>
        Clear filters
      </button>
    </div>

    <ItemGrid items={sortedItems} slugs={slugs} />

    <nav class="catalog__pagination" data-pagination aria-label="Catalog pagination">
      <button class="pagination__btn pagination__btn--prev" data-pagination-prev disabled>
        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
          <path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/>
        </svg>
        Previous
      </button>
      <div class="pagination__info">
        <span data-pagination-info>Page 1 of 1</span>
      </div>
      <button class="pagination__btn pagination__btn--next" data-pagination-next disabled>
        Next
        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
          <path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/>
        </svg>
      </button>
    </nav>
  </main>
</div>

<script>
  class CatalogFilter {
    private allItems: HTMLElement[];
    private filterInputs: NodeListOf<HTMLInputElement>;
    private countDisplay: HTMLElement | null;
    private clearButton: HTMLElement | null;
    private paginationNav: HTMLElement | null;
    private prevBtn: HTMLButtonElement | null;
    private nextBtn: HTMLButtonElement | null;
    private pageInfo: HTMLElement | null;
    private selectedTags: Set<string> = new Set();
    private itemsPerPage: number;
    private currentPage: number = 1;
    private visibleItems: HTMLElement[] = [];

    constructor(container: HTMLElement) {
      this.allItems = Array.from(container.querySelectorAll('[data-software-item]'));
      this.filterInputs = container.querySelectorAll('[data-filter-tag]');
      this.countDisplay = container.querySelector('[data-filter-count]');
      this.clearButton = container.querySelector('[data-clear-filters]');
      this.paginationNav = container.querySelector('[data-pagination]');
      this.prevBtn = container.querySelector('[data-pagination-prev]');
      this.nextBtn = container.querySelector('[data-pagination-next]');
      this.pageInfo = container.querySelector('[data-pagination-info]');
      this.itemsPerPage = parseInt(container.dataset.itemsPerPage ?? '24', 10);

      this.init();
    }

    private init(): void {
      this.loadFromURL();
      this.bindEvents();
      this.applyFilters();
    }

    private loadFromURL(): void {
      const params = new URLSearchParams(window.location.search);
      const tags = params.get('tags')?.split(',').filter(Boolean) ?? [];
      this.selectedTags = new Set(tags);
      this.currentPage = parseInt(params.get('page') ?? '1', 10);

      this.filterInputs.forEach(input => {
        input.checked = this.selectedTags.has(input.value);
      });
    }

    private saveToURL(): void {
      const params = new URLSearchParams();

      if (this.selectedTags.size > 0) {
        params.set('tags', [...this.selectedTags].join(','));
      }

      if (this.currentPage > 1) {
        params.set('page', String(this.currentPage));
      }

      const newURL = params.toString()
        ? `${window.location.pathname}?${params.toString()}`
        : window.location.pathname;

      window.history.replaceState({}, '', newURL);
    }

    private bindEvents(): void {
      this.filterInputs.forEach(input => {
        input.addEventListener('change', () => this.handleFilterChange(input));
      });

      this.clearButton?.addEventListener('click', () => this.clearFilters());
      this.prevBtn?.addEventListener('click', () => this.goToPage(this.currentPage - 1));
      this.nextBtn?.addEventListener('click', () => this.goToPage(this.currentPage + 1));
    }

    private handleFilterChange(input: HTMLInputElement): void {
      if (input.checked) {
        this.selectedTags.add(input.value);
      } else {
        this.selectedTags.delete(input.value);
      }

      this.currentPage = 1; // Reset to first page when filter changes
      this.applyFilters();
      this.saveToURL();
    }

    private applyFilters(): void {
      // First, determine which items match the filter
      this.visibleItems = this.allItems.filter(item => {
        const itemTags: string[] = JSON.parse(item.dataset.tags ?? '[]');
        return this.selectedTags.size === 0 ||
          itemTags.some(tag => this.selectedTags.has(tag));
      });

      // Calculate pagination
      const totalPages = Math.max(1, Math.ceil(this.visibleItems.length / this.itemsPerPage));

      // Ensure current page is valid
      if (this.currentPage > totalPages) {
        this.currentPage = totalPages;
      }

      const startIdx = (this.currentPage - 1) * this.itemsPerPage;
      const endIdx = startIdx + this.itemsPerPage;

      // Hide all items first
      this.allItems.forEach(item => {
        item.style.display = 'none';
      });

      // Show only items for current page
      this.visibleItems.slice(startIdx, endIdx).forEach(item => {
        item.style.display = '';
      });

      this.updateCount(this.visibleItems.length, startIdx + 1, Math.min(endIdx, this.visibleItems.length));
      this.updatePagination(totalPages);
      this.updateClearButton();
    }

    private updateCount(total: number, start: number, end: number): void {
      if (this.countDisplay) {
        if (total === 0) {
          this.countDisplay.textContent = 'No items found';
        } else if (total <= this.itemsPerPage) {
          this.countDisplay.textContent = `Showing ${total} item${total !== 1 ? 's' : ''}`;
        } else {
          this.countDisplay.textContent = `Showing ${start}-${end} of ${total} items`;
        }
      }
    }

    private updatePagination(totalPages: number): void {
      if (!this.paginationNav) return;

      // Hide pagination if only one page
      if (totalPages <= 1) {
        this.paginationNav.hidden = true;
        return;
      }

      this.paginationNav.hidden = false;

      if (this.prevBtn) {
        this.prevBtn.disabled = this.currentPage <= 1;
      }
      if (this.nextBtn) {
        this.nextBtn.disabled = this.currentPage >= totalPages;
      }
      if (this.pageInfo) {
        this.pageInfo.textContent = `Page ${this.currentPage} of ${totalPages}`;
      }
    }

    private updateClearButton(): void {
      if (this.clearButton) {
        this.clearButton.hidden = this.selectedTags.size === 0;
      }
    }

    private goToPage(page: number): void {
      const totalPages = Math.ceil(this.visibleItems.length / this.itemsPerPage);
      if (page < 1 || page > totalPages) return;

      this.currentPage = page;
      this.applyFilters();
      this.saveToURL();

      // Scroll to top of catalog
      document.querySelector('[data-catalog]')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    private clearFilters(): void {
      this.selectedTags.clear();
      this.currentPage = 1;

      this.filterInputs.forEach(input => {
        input.checked = false;
      });

      this.applyFilters();
      this.saveToURL();
    }
  }

  function initCatalog() {
    const catalog = document.querySelector('[data-catalog]');
    if (catalog instanceof HTMLElement) {
      new CatalogFilter(catalog);
    }
  }

  document.addEventListener('DOMContentLoaded', initCatalog);
  document.addEventListener('astro:page-load', initCatalog);
</script>

<style>
  .catalog {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 2rem;
  }

  .catalog__content {
    min-width: 0;
  }

  .catalog__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--sl-color-gray-5);
  }

  .catalog__count {
    color: var(--sl-color-gray-2);
    font-size: 0.875rem;
  }

  .catalog__clear {
    background: none;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.25rem;
    padding: 0.25rem 0.75rem;
    color: var(--sl-color-text);
    cursor: pointer;
    font-size: 0.75rem;
    transition: background-color 0.15s ease;
  }

  .catalog__clear:hover {
    background: var(--sl-color-gray-6);
  }

  .catalog__pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--sl-color-gray-5);
  }

  .catalog__pagination[hidden] {
    display: none;
  }

  .pagination__btn {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.5rem 0.875rem;
    background: var(--sl-color-gray-6);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.375rem;
    color: var(--sl-color-text);
    font-size: 0.8125rem;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .pagination__btn:hover:not(:disabled) {
    background: var(--sl-color-gray-5);
    border-color: var(--sl-color-gray-4);
  }

  .pagination__btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .pagination__info {
    font-size: 0.8125rem;
    color: var(--sl-color-gray-2);
    min-width: 6rem;
    text-align: center;
  }

  @media (max-width: 768px) {
    .catalog {
      grid-template-columns: 1fr;
    }
  }
</style>

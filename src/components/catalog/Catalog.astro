---
import type { SoftwareEntry } from '../../lib/software';
import { getAllTags, getEntrySlugs, categorizeTags, getTagCounts, sortByName } from '../../lib/software';
import FilterSidebar from './FilterSidebar.astro';
import ItemGrid from './ItemGrid.astro';
import SearchBar from './SearchBar.astro';

interface Props {
  items: SoftwareEntry[];
  itemsPerPage?: number;
}

const { items, itemsPerPage = 24 } = Astro.props;

const slugs = getEntrySlugs(items);
const allTags = getAllTags(items);
const { linked, plain } = categorizeTags(allTags, slugs);
const tagCounts = getTagCounts(items);
const sortedItems = sortByName(items);
---

<div class="catalog" data-catalog data-items-per-page={itemsPerPage}>
  <FilterSidebar linkedTags={linked} plainTags={plain} tagCounts={tagCounts} />

  <main class="catalog__content">
    <div class="catalog__search">
      <SearchBar placeholder="Search by name or description..." />
    </div>

    <div class="catalog__header">
      <span class="catalog__count" data-filter-count>
        Showing {sortedItems.length} items
      </span>
      <button class="catalog__clear" data-clear-filters hidden>
        Clear filters
      </button>
    </div>

    <ItemGrid items={sortedItems} slugs={slugs} />

    <nav class="catalog__pagination" data-pagination aria-label="Catalog pagination">
      <button class="pagination__btn pagination__btn--prev" data-pagination-prev disabled>
        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
          <path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/>
        </svg>
        Previous
      </button>
      <div class="pagination__info">
        <span data-pagination-info>Page 1 of 1</span>
      </div>
      <button class="pagination__btn pagination__btn--next" data-pagination-next disabled>
        Next
        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
          <path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/>
        </svg>
      </button>
    </nav>
  </main>
</div>

<script>
  class CatalogFilter {
    private allItems: HTMLElement[];
    private filterInputs: NodeListOf<HTMLInputElement>;
    private searchInput: HTMLInputElement | null;
    private searchClearBtn: HTMLElement | null;
    private countDisplay: HTMLElement | null;
    private clearButton: HTMLElement | null;
    private paginationNav: HTMLElement | null;
    private prevBtn: HTMLButtonElement | null;
    private nextBtn: HTMLButtonElement | null;
    private pageInfo: HTMLElement | null;
    private selectedTags: Set<string> = new Set();
    private searchQuery: string = '';
    private platformMode: 'any' | 'all' = 'any';
    private tagMode: 'any' | 'all' = 'any';
    private groupMode: 'any' | 'all' = 'any';
    private itemsPerPage: number;
    private currentPage: number = 1;
    private visibleItems: HTMLElement[] = [];

    constructor(container: HTMLElement) {
      this.allItems = Array.from(container.querySelectorAll('[data-software-item]'));
      this.filterInputs = container.querySelectorAll('[data-filter-tag]');
      this.searchInput = container.querySelector('[data-search-input]');
      this.searchClearBtn = container.querySelector('[data-search-clear]');
      this.countDisplay = container.querySelector('[data-filter-count]');
      this.clearButton = container.querySelector('[data-clear-filters]');
      this.paginationNav = container.querySelector('[data-pagination]');
      this.prevBtn = container.querySelector('[data-pagination-prev]');
      this.nextBtn = container.querySelector('[data-pagination-next]');
      this.pageInfo = container.querySelector('[data-pagination-info]');
      this.itemsPerPage = parseInt(container.dataset.itemsPerPage ?? '24', 10);

      this.init();
    }

    private init(): void {
      this.loadFromURL();
      this.bindEvents();
      this.applyFilters();
    }

    private loadFromURL(): void {
      const params = new URLSearchParams(window.location.search);
      const tags = params.get('tags')?.split(',').filter(Boolean) ?? [];
      this.selectedTags = new Set(tags);
      this.searchQuery = params.get('q') ?? '';
      this.platformMode = (params.get('pm') as 'any' | 'all') || 'any';
      this.tagMode = (params.get('tm') as 'any' | 'all') || 'any';
      this.groupMode = (params.get('gm') as 'any' | 'all') || 'any';
      this.currentPage = parseInt(params.get('page') ?? '1', 10);

      this.filterInputs.forEach(input => {
        input.checked = this.selectedTags.has(input.value);
      });

      if (this.searchInput) {
        this.searchInput.value = this.searchQuery;
      }
      this.updateSearchClearButton();
      this.syncModeToggles();
    }

    private saveToURL(): void {
      const params = new URLSearchParams();

      if (this.searchQuery) {
        params.set('q', this.searchQuery);
      }

      if (this.selectedTags.size > 0) {
        params.set('tags', [...this.selectedTags].join(','));
      }

      if (this.platformMode !== 'any') {
        params.set('pm', this.platformMode);
      }

      if (this.tagMode !== 'any') {
        params.set('tm', this.tagMode);
      }

      if (this.groupMode !== 'any') {
        params.set('gm', this.groupMode);
      }

      if (this.currentPage > 1) {
        params.set('page', String(this.currentPage));
      }

      const newURL = params.toString()
        ? `${window.location.pathname}?${params.toString()}`
        : window.location.pathname;

      window.history.replaceState({}, '', newURL);
    }

    private updateSearchClearButton(): void {
      if (this.searchClearBtn) {
        this.searchClearBtn.hidden = !this.searchQuery;
      }
    }

    private syncModeToggles(): void {
      // Sync platform mode toggle
      const platformToggle = document.querySelector('[data-mode-toggle="platforms"]');
      platformToggle?.querySelectorAll('[data-mode]').forEach(btn => {
        const mode = (btn as HTMLElement).dataset.mode;
        const isActive = mode === this.platformMode;
        btn.classList.toggle('mode-toggle__btn--active', isActive);
        btn.setAttribute('aria-pressed', String(isActive));
      });

      // Sync tag mode toggle
      const tagToggle = document.querySelector('[data-mode-toggle="tags"]');
      tagToggle?.querySelectorAll('[data-mode]').forEach(btn => {
        const mode = (btn as HTMLElement).dataset.mode;
        const isActive = mode === this.tagMode;
        btn.classList.toggle('mode-toggle__btn--active', isActive);
        btn.setAttribute('aria-pressed', String(isActive));
      });

      // Sync group mode toggle
      const groupToggle = document.querySelector('[data-mode-toggle="groups"]');
      groupToggle?.querySelectorAll('[data-mode]').forEach(btn => {
        const mode = (btn as HTMLElement).dataset.mode;
        const isActive = mode === this.groupMode;
        btn.classList.toggle('mode-toggle__btn--active', isActive);
        btn.setAttribute('aria-pressed', String(isActive));
      });
    }

    private bindEvents(): void {
      this.filterInputs.forEach(input => {
        input.addEventListener('change', () => this.handleFilterChange(input));
      });

      // Search input events
      this.searchInput?.addEventListener('input', () => this.handleSearchInput());
      this.searchClearBtn?.addEventListener('click', () => this.clearSearch());

      // Mode toggle events (using event delegation on document)
      document.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest('[data-mode]');
        if (btn instanceof HTMLButtonElement) {
          const toggle = btn.closest('[data-mode-toggle]');
          const group = (toggle as HTMLElement)?.dataset.modeToggle;
          const mode = btn.dataset.mode as 'any' | 'all';
          if (group && mode) {
            this.handleModeChange(group, mode);
          }
        }
      });

      this.clearButton?.addEventListener('click', () => this.clearFilters());
      this.prevBtn?.addEventListener('click', () => this.goToPage(this.currentPage - 1));
      this.nextBtn?.addEventListener('click', () => this.goToPage(this.currentPage + 1));
    }

    private handleModeChange(group: string, mode: 'any' | 'all'): void {
      let changed = false;

      if (group === 'platforms' && this.platformMode !== mode) {
        this.platformMode = mode;
        changed = true;
      } else if (group === 'tags' && this.tagMode !== mode) {
        this.tagMode = mode;
        changed = true;
      } else if (group === 'groups' && this.groupMode !== mode) {
        this.groupMode = mode;
        changed = true;
      }

      if (changed) {
        this.currentPage = 1;
        this.syncModeToggles();
        this.applyFilters();
        this.saveToURL();
      }
    }

    private handleSearchInput(): void {
      this.searchQuery = this.searchInput?.value.toLowerCase().trim() ?? '';
      this.currentPage = 1;
      this.updateSearchClearButton();
      this.applyFilters();
      this.saveToURL();
    }

    private clearSearch(): void {
      this.searchQuery = '';
      if (this.searchInput) {
        this.searchInput.value = '';
      }
      this.updateSearchClearButton();
      this.currentPage = 1;
      this.applyFilters();
      this.saveToURL();
    }

    private handleFilterChange(input: HTMLInputElement): void {
      if (input.checked) {
        this.selectedTags.add(input.value);
      } else {
        this.selectedTags.delete(input.value);
      }

      this.currentPage = 1; // Reset to first page when filter changes
      this.applyFilters();
      this.saveToURL();
    }

    private getSelectedTagsByGroup(): { platforms: Set<string>; tags: Set<string> } {
      const platforms = new Set<string>();
      const tags = new Set<string>();

      this.filterInputs.forEach(input => {
        if (input.checked) {
          const group = input.dataset.tagGroup;
          if (group === 'platforms') {
            platforms.add(input.value);
          } else {
            tags.add(input.value);
          }
        }
      });

      return { platforms, tags };
    }

    private updateModeToggleVisibility(): void {
      // Get selected counts per group
      const { platforms, tags } = this.getSelectedTagsByGroup();

      // Show platform mode toggle if 2+ platforms selected
      const platformToggle = document.querySelector('[data-mode-toggle="platforms"]');
      if (platformToggle instanceof HTMLElement) {
        platformToggle.hidden = platforms.size < 2;
      }

      // Show tag mode toggle if 2+ tags selected
      const tagToggle = document.querySelector('[data-mode-toggle="tags"]');
      if (tagToggle instanceof HTMLElement) {
        tagToggle.hidden = tags.size < 2;
      }
    }

    private applyFilters(): void {
      this.updateModeToggleVisibility();

      const { platforms, tags } = this.getSelectedTagsByGroup();

      // First, determine which items match filters
      this.visibleItems = this.allItems.filter(item => {
        const itemTags: string[] = JSON.parse(item.dataset.tags ?? '[]');

        // Check platform filter
        let matchesPlatforms: boolean;
        if (platforms.size === 0) {
          matchesPlatforms = true;
        } else if (this.platformMode === 'all') {
          matchesPlatforms = [...platforms].every(p => itemTags.includes(p));
        } else {
          matchesPlatforms = [...platforms].some(p => itemTags.includes(p));
        }

        // Check tag filter
        let matchesTags: boolean;
        if (tags.size === 0) {
          matchesTags = true;
        } else if (this.tagMode === 'all') {
          matchesTags = [...tags].every(t => itemTags.includes(t));
        } else {
          matchesTags = [...tags].some(t => itemTags.includes(t));
        }

        // Combine groups based on groupMode
        let matchesFilters: boolean;
        if (platforms.size === 0 && tags.size === 0) {
          matchesFilters = true;
        } else if (platforms.size === 0) {
          matchesFilters = matchesTags;
        } else if (tags.size === 0) {
          matchesFilters = matchesPlatforms;
        } else if (this.groupMode === 'all') {
          matchesFilters = matchesPlatforms && matchesTags;
        } else {
          matchesFilters = matchesPlatforms || matchesTags;
        }

        // Check search query
        const matchesSearch = !this.searchQuery ||
          (item.dataset.name?.includes(this.searchQuery) ?? false) ||
          (item.dataset.description?.includes(this.searchQuery) ?? false);

        return matchesFilters && matchesSearch;
      });

      // Calculate pagination
      const totalPages = Math.max(1, Math.ceil(this.visibleItems.length / this.itemsPerPage));

      // Ensure current page is valid
      if (this.currentPage > totalPages) {
        this.currentPage = totalPages;
      }

      const startIdx = (this.currentPage - 1) * this.itemsPerPage;
      const endIdx = startIdx + this.itemsPerPage;

      // Hide all items first
      this.allItems.forEach(item => {
        item.style.display = 'none';
      });

      // Show only items for current page
      this.visibleItems.slice(startIdx, endIdx).forEach(item => {
        item.style.display = '';
      });

      this.updateCount(this.visibleItems.length, startIdx + 1, Math.min(endIdx, this.visibleItems.length));
      this.updatePagination(totalPages);
      this.updateClearButton();
    }

    private updateCount(total: number, start: number, end: number): void {
      if (this.countDisplay) {
        if (total === 0) {
          this.countDisplay.textContent = 'No items found';
        } else if (total <= this.itemsPerPage) {
          this.countDisplay.textContent = `Showing ${total} item${total !== 1 ? 's' : ''}`;
        } else {
          this.countDisplay.textContent = `Showing ${start}-${end} of ${total} items`;
        }
      }
    }

    private updatePagination(totalPages: number): void {
      if (!this.paginationNav) return;

      // Hide pagination if only one page
      if (totalPages <= 1) {
        this.paginationNav.hidden = true;
        return;
      }

      this.paginationNav.hidden = false;

      if (this.prevBtn) {
        this.prevBtn.disabled = this.currentPage <= 1;
      }
      if (this.nextBtn) {
        this.nextBtn.disabled = this.currentPage >= totalPages;
      }
      if (this.pageInfo) {
        this.pageInfo.textContent = `Page ${this.currentPage} of ${totalPages}`;
      }
    }

    private updateClearButton(): void {
      if (this.clearButton) {
        this.clearButton.hidden = this.selectedTags.size === 0 && !this.searchQuery;
      }
    }

    private goToPage(page: number): void {
      const totalPages = Math.ceil(this.visibleItems.length / this.itemsPerPage);
      if (page < 1 || page > totalPages) return;

      this.currentPage = page;
      this.applyFilters();
      this.saveToURL();

      // Scroll to top of catalog
      document.querySelector('[data-catalog]')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    private clearFilters(): void {
      this.selectedTags.clear();
      this.searchQuery = '';
      this.platformMode = 'any';
      this.tagMode = 'any';
      this.groupMode = 'any';
      this.currentPage = 1;

      this.filterInputs.forEach(input => {
        input.checked = false;
      });

      if (this.searchInput) {
        this.searchInput.value = '';
      }
      this.updateSearchClearButton();
      this.syncModeToggles();

      this.applyFilters();
      this.saveToURL();
    }
  }

  function initCatalog() {
    const catalog = document.querySelector('[data-catalog]');
    if (catalog instanceof HTMLElement) {
      new CatalogFilter(catalog);
    }
  }

  document.addEventListener('DOMContentLoaded', initCatalog);
  document.addEventListener('astro:page-load', initCatalog);
</script>

<style>
  .catalog {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 2rem;
  }

  .catalog__content {
    min-width: 0;
    margin-top: 0;
  }

  .catalog__search {
    margin-bottom: 1rem;
  }

  .catalog__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--sl-color-gray-5);
  }

  .catalog__count {
    color: var(--sl-color-gray-2);
    font-size: 0.875rem;
  }

  .catalog__clear {
    background: none;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.25rem;
    padding: 0.25rem 0.75rem;
    color: var(--sl-color-text);
    cursor: pointer;
    font-size: 0.75rem;
    transition: background-color 0.15s ease;
  }

  .catalog__clear:hover {
    background: var(--sl-color-gray-6);
  }

  .catalog__pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--sl-color-gray-5);
  }

  .catalog__pagination > * {
    margin: 0;
    vertical-align: middle;
  }

  .catalog__pagination[hidden] {
    display: none;
  }

  .pagination__btn {
    display: inline-flex;
    align-items: center;
    align-self: center;
    justify-content: center;
    gap: 0.375rem;
    padding: 0.5rem 0.875rem;
    background: var(--sl-color-gray-6);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.375rem;
    color: var(--sl-color-text);
    font-size: 0.8125rem;
    line-height: 1;
    cursor: pointer;
    transition: all 0.15s ease;
    min-width: 6.5rem;
    height: 2.25rem;
    margin: 0;
  }

  .pagination__btn svg {
    flex-shrink: 0;
  }

  .pagination__btn:hover:not(:disabled) {
    background: var(--sl-color-gray-5);
    border-color: var(--sl-color-gray-4);
  }

  .pagination__btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .pagination__info {
    display: flex;
    align-items: center;
    align-self: center;
    justify-content: center;
    font-size: 0.8125rem;
    color: var(--sl-color-gray-2);
    min-width: 6rem;
    text-align: center;
    height: 2.25rem;
    margin: 0;
  }

  @media (max-width: 768px) {
    .catalog {
      grid-template-columns: 1fr;
    }
  }
</style>

---
interface Props {
  linkedTags: string[];
  plainTags: string[];
  tagCounts: Map<string, number>;
}

const { linkedTags, plainTags, tagCounts } = Astro.props;
---

<aside class="filter-sidebar" data-filter-sidebar>
  {linkedTags.length > 0 && (
    <div class="filter-group">
      <h3 class="filter-group__title">Platforms</h3>
      <div class="filter-group__options">
        {linkedTags.map(tag => (
          <label class="filter-checkbox">
            <input
              type="checkbox"
              name="tag"
              value={tag}
              data-filter-tag
            />
            <span class="filter-checkbox__indicator"></span>
            <span class="filter-checkbox__label">{tag}</span>
            <span class="filter-checkbox__count">{tagCounts.get(tag) ?? 0}</span>
          </label>
        ))}
      </div>
    </div>
  )}

  {plainTags.length > 0 && (
    <div class="filter-group">
      <h3 class="filter-group__title">Tags</h3>
      <div class="filter-group__options">
        {plainTags.map(tag => (
          <label class="filter-checkbox">
            <input
              type="checkbox"
              name="tag"
              value={tag}
              data-filter-tag
            />
            <span class="filter-checkbox__indicator"></span>
            <span class="filter-checkbox__label">{tag}</span>
            <span class="filter-checkbox__count">{tagCounts.get(tag) ?? 0}</span>
          </label>
        ))}
      </div>
    </div>
  )}
</aside>

<style>
  .filter-sidebar {
    padding: 1rem;
    background: var(--sl-color-gray-6);
    border-radius: 0.5rem;
  }

  .filter-group {
    margin-bottom: 1.5rem;
  }

  .filter-group:last-child {
    margin-bottom: 0;
  }

  .filter-group__title {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--sl-color-gray-2);
    margin: 0 0 0.75rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--sl-color-gray-5);
  }

  .filter-group__options {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .filter-checkbox {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    padding: 0.375rem 0.5rem;
    border-radius: 0.25rem;
    transition: background-color 0.15s ease;
  }

  .filter-checkbox:hover {
    background: var(--sl-color-gray-5);
  }

  .filter-checkbox input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }

  .filter-checkbox__indicator {
    width: 1rem;
    height: 1rem;
    border: 2px solid var(--sl-color-gray-3);
    border-radius: 0.25rem;
    flex-shrink: 0;
    transition: all 0.15s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .filter-checkbox__indicator::after {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    background: var(--sl-color-accent);
    border-radius: 0.125rem;
    opacity: 0;
    transform: scale(0);
    transition: all 0.15s ease;
  }

  .filter-checkbox input:checked + .filter-checkbox__indicator {
    border-color: var(--sl-color-accent);
  }

  .filter-checkbox input:checked + .filter-checkbox__indicator::after {
    opacity: 1;
    transform: scale(1);
  }

  .filter-checkbox__label {
    font-size: 0.875rem;
    color: var(--sl-color-text);
    flex: 1;
  }

  .filter-checkbox__count {
    font-size: 0.75rem;
    color: var(--sl-color-gray-2);
    background: var(--sl-color-gray-5);
    padding: 0.125rem 0.375rem;
    border-radius: 1rem;
    min-width: 1.5rem;
    text-align: center;
  }
</style>

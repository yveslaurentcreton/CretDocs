---
import { Icon } from '@astrojs/starlight/components';
import Tag from './Tag.astro';

interface Props {
  name: string;
  slug: string;
  description?: string;
  externalLink?: string | null;
  tags?: string[];
  render?: boolean;
  slugs: Set<string>;
}

const { name, slug, description, externalLink, tags = [], render, slugs } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
const detailUrl = render ? `${baseUrl}/toolbox/software/${slug}` : undefined;
---

<article
  class="item-card"
  data-software-item
  data-tags={JSON.stringify(tags)}
  data-name={name.toLowerCase()}
  data-description={description?.toLowerCase() ?? ''}
>
  <header class="item-card__header">
    <h3 class="item-card__name">
      {detailUrl ? (
        <a href={detailUrl}>{name}</a>
      ) : (
        name
      )}
    </h3>
    {externalLink && (
      <a
        href={externalLink}
        target="_blank"
        rel="noopener noreferrer"
        class="item-card__external"
        aria-label={`Open ${name} in new tab`}
      >
        <Icon name="external" size="1rem" />
      </a>
    )}
  </header>

  {tags.length > 0 && (
    <div class="item-card__tags">
      {tags.map(tag => (
        <Tag tag={tag} isLinked={slugs.has(tag)} />
      ))}
    </div>
  )}

  {description && (
    <p class="item-card__description">{description}</p>
  )}
</article>

<style>
  .item-card {
    padding: 1rem;
    background: var(--sl-color-gray-6);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .item-card:hover {
    border-color: var(--sl-color-gray-4);
  }

  .item-card__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .item-card__name {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .item-card__name a {
    color: var(--sl-color-text);
    text-decoration: none;
  }

  .item-card__name a:hover {
    color: var(--sl-color-accent);
    text-decoration: underline;
  }

  .item-card__external {
    color: var(--sl-color-gray-2);
    flex-shrink: 0;
    padding: 0.25rem;
    transition: color 0.15s ease;
  }

  .item-card__external:hover {
    color: var(--sl-color-accent);
  }

  .item-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-bottom: 0.5rem;
  }

  .item-card__description {
    margin: 0;
    font-size: 0.875rem;
    color: var(--sl-color-gray-2);
    line-height: 1.5;
  }
</style>

---
interface Props {
  tag: string;
  isLinked: boolean;
  baseUrl?: string;
}

const { tag, isLinked, baseUrl = import.meta.env.BASE_URL } = Astro.props;
const href = isLinked ? `${baseUrl}/toolbox/software/${tag}` : undefined;
---

{isLinked ? (
  <a href={href} class="tag tag--linked">
    {tag}
  </a>
) : (
  <span class="tag tag--plain">
    {tag}
  </span>
)}

<style>
  .tag {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 500;
    padding: 0.125rem 0.5rem;
    border-radius: 1rem;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .tag--plain {
    background: var(--sl-color-gray-5);
    color: var(--sl-color-gray-2);
  }

  .tag--linked {
    background: var(--sl-color-accent-low);
    color: var(--sl-color-accent);
    border: 1px solid var(--sl-color-accent);
  }

  .tag--linked:hover {
    background: var(--sl-color-accent);
    color: var(--sl-color-white);
  }
</style>

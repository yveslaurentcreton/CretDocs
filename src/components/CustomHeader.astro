---
import Default from '@astrojs/starlight/components/Header.astro';
import WidthToggle from './WidthToggle.astro';
---

<Default {...Astro.props}>
  <slot />
</Default>

<div class="custom-header-actions">
  <WidthToggle />
</div>

<style>
  .custom-header-actions {
    position: fixed;
    top: 0.75rem;
    right: 1rem;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  @media (min-width: 50rem) {
    .custom-header-actions {
      right: 1.5rem;
    }
  }
</style>

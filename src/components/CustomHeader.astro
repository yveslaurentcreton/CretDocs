---
import Default from '@astrojs/starlight/components/Header.astro';
import WidthToggle from './WidthToggle.astro';
---

<Default {...Astro.props}>
  <slot />
</Default>

<!-- Render the toggle button hidden, then move it via script -->
<div id="width-toggle-source" hidden>
  <WidthToggle />
</div>

<script>
  const STORAGE_KEY = 'cretdocs-width-preference';
  const FULL_WIDTH_CLASS = 'layout-full-width';

  function updateButtonState(button: Element) {
    const isFullWidth = document.documentElement.classList.contains(FULL_WIDTH_CLASS);
    button.setAttribute('data-state', isFullWidth ? 'full' : 'contained');
    button.setAttribute('aria-pressed', String(isFullWidth));
  }

  function injectWidthToggle() {
    const source = document.getElementById('width-toggle-source');
    const toggle = source?.querySelector('.width-toggle');
    if (!toggle) return;

    // Check if already injected (for view transitions)
    if (document.querySelector('.width-toggle-wrapper .width-toggle')) {
      source?.remove();
      return;
    }

    // Find the right-group in the header
    const rightGroup = document.querySelector('header .right-group, header [class*="right"]');
    if (!rightGroup) return;

    // Clone and set up the button
    const clonedToggle = toggle.cloneNode(true) as HTMLElement;

    // Load saved preference and update state
    const savedPref = localStorage.getItem(STORAGE_KEY);
    if (savedPref === 'full') {
      document.documentElement.classList.add(FULL_WIDTH_CLASS);
    }
    updateButtonState(clonedToggle);

    // Attach click handler
    clonedToggle.addEventListener('click', () => {
      const isFullWidth = document.documentElement.classList.toggle(FULL_WIDTH_CLASS);
      localStorage.setItem(STORAGE_KEY, isFullWidth ? 'full' : 'contained');
      updateButtonState(clonedToggle);
    });

    // Create wrapper with separator
    const wrapper = document.createElement('div');
    wrapper.className = 'width-toggle-wrapper';
    wrapper.appendChild(clonedToggle);

    // Insert before LanguageSelect if it exists, otherwise at the end
    const langSelect = rightGroup.querySelector('starlight-lang-select');
    if (langSelect) {
      rightGroup.insertBefore(wrapper, langSelect);
    } else {
      rightGroup.appendChild(wrapper);
    }

    // Clean up the source
    source?.remove();
  }

  document.addEventListener('DOMContentLoaded', injectWidthToggle);
  document.addEventListener('astro:page-load', injectWidthToggle);
</script>

<style is:global>
  .width-toggle-wrapper {
    display: flex;
    align-items: center;
    padding-inline-start: 1rem;
    border-inline-start: 1px solid var(--sl-color-gray-5);
  }
</style>
